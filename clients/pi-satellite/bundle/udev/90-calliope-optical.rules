# Installed by the Calliope satellite (install.sh). A C-Media CM6206 card's
# registers (its optical input's mix) are reached over its HID interface:
# the audio group, which the agent's user is in, may open it.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0d8c", ATTRS{idProduct}=="0102", GROUP="audio", MODE="0660"
