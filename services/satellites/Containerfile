# voice-satellites: the hub for thin audio devices (clients/korvo-satellite).
#
# Build from the repository root, like every image here, because
# packages/common is a path dependency and must be inside the context:
#
#   docker build -f services/satellites/Containerfile -t calliope-satellites .
#
# NO GPU, NO SUBPROCESS. The image is fastapi and uvicorn, numpy for the
# audio front-end (app/frontend.py), ONNX Runtime for the wake words and
# webrtcvad for the endpointer. State is one JSON file, the rules, the
# uploaded firmware images and any extra wake word models, on the /data volume.
#
# No HEALTHCHECK here, for the reason the other Containerfiles give: CI builds
# OCI images with buildah, which drops it. The check lives in compose.yaml.
FROM python:3.13-slim-trixie

# setpriv, for voice-entrypoint.sh to drop to uid 1000 after the chown.
RUN apt-get update \
 && apt-get install -y --no-install-recommends util-linux \
 && rm -rf /var/lib/apt/lists/* \
 && command -v setpriv

WORKDIR /srv
COPY packages/common/ ./packages/common/
COPY services/satellites/requirements.txt services/satellites/requirements-nodeps.txt ./
# Two steps, and the second without dependencies: openwakeword still names
# tflite-runtime, which has no wheel for this Python (requirements-nodeps.txt).
RUN pip install --no-cache-dir -r requirements.txt \
 && pip install --no-cache-dir --no-deps -r requirements-nodeps.txt

# THE DEFAULT WAKE WORD IS IN THE IMAGE, so a first start needs no network. The
# files are fetched from openWakeWord's release and checked against the SHA-256
# pinned in wakeword.py, which runs here on its own before the rest of the app
# is copied, so an edit to the app does not fetch them again. At start-up the
# hub copies them onto the volume (SATELLITES_MODEL_DIR) and fetches any other
# name there. The models are CC BY-NC-SA 4.0, not the code's licence: the
# attribution goes into the image beside them, and THIRD-PARTY-NOTICES.md says
# on what terms an image carrying them may be shared.
#
# --build-arg WAKE_WORDS= (empty) builds an image with no model in it at all;
# the hub then fetches what SATELLITES_WAKE_WORDS names onto the volume at start-up.
ARG WAKE_WORDS="hey_jarvis"
COPY services/satellites/app/wakeword.py /tmp/wakeword.py
COPY services/satellites/MODELS-NOTICE.md /tmp/MODELS-NOTICE.md
RUN if [ -n "${WAKE_WORDS}" ]; then \
      python /tmp/wakeword.py /srv/models ${WAKE_WORDS} \
      && cp /tmp/MODELS-NOTICE.md /srv/models/NOTICE.md \
      && ls -l /srv/models; \
    fi \
 && rm /tmp/wakeword.py /tmp/MODELS-NOTICE.md

COPY services/satellites/app/ ./app/

# ORT_DISABLE_TELEMETRY: ONNX Runtime's Linux wheel reports usage to Microsoft
# and writes a device id otherwise (measured; see app/wakeword.py). The app sets
# it too, but only when it runs first; this covers every process in the image.
ENV SATELLITES_DATA_DIR=/data \
    VOICE_CHOWN_DIRS=/data \
    VOICE_TLS_PREFIX=SATELLITES \
    ORT_DISABLE_TELEMETRY=1 \
    PYTHONUNBUFFERED=1

RUN useradd --create-home --uid 1000 satellites
VOLUME ["/data"]
EXPOSE 8003
ENTRYPOINT ["voice-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8003"]
