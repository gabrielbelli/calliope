#!/bin/sh
# A STAND-IN FOR yt-dlp's METADATA PROBE, for the browser tests and nothing
# else. services/ui/app/probe.py runs `yt-dlp -J --skip-download ... -- <url>`
# when a link is resolved and reads five things out of the info-dict it prints:
# title, uploader, duration, the largest audio-only format's size, whether it
# is live, and whether it has subtitles a person wrote. This prints a dict of
# that shape, chosen by a word in the link, so the confirm card's every branch
# can be reached without the network:
#
#     unprobed   exits 1, as a stale extractor does: the card has no length
#     live       a live stream: no duration, no size, is_live
#     subs       180 s, with human subtitles as well as automatic ones
#     long       7200 s, two hours
#     anything   180 s
#
# A SHELL SCRIPT AND NOT PYTHON, on purpose. stack.py puts this directory first
# on the page server's PATH and leaves the venv (which has the real yt-dlp)
# off it, so nothing the stack starts can find a downloader that would reach
# for the network; and /bin/sh is the one interpreter whose path is the same
# on every machine, where `env python3` could find a system stub that opens
# an installer dialog.

for arg; do url=$arg; done
case " $* " in
  *" -J "*) ;;
  *) echo "this stand-in only answers -J" >&2; exit 2 ;;
esac

slug=${url%/}
slug=${slug##*/}
duration=180 live=false status=not_live audio=2880000 subs="{}"
case "$url" in
  *unprobed*) echo "ERROR: [generic] Unable to extract info (the stand-in was asked to fail)" >&2
              exit 1 ;;
  *live*) duration=null live=true status=is_live audio=null ;;
  *long*) duration=7200 audio=115200000 ;;
esac
case "$url" in
  *subs*) subs='{"en": [{"ext": "vtt", "url": "https://example.com/subtitles.en.vtt"}]}' ;;
esac

cat <<JSON
{"id": "e2e-$slug", "title": "Probed talk $slug", "uploader": "Example Channel",
 "duration": $duration, "is_live": $live, "live_status": "$status",
 "subtitles": $subs,
 "automatic_captions": {"en": [{"ext": "vtt", "url": "https://example.com/auto.en.vtt"}]},
 "formats": [{"format_id": "251", "vcodec": "none", "acodec": "opus", "filesize": $audio},
             {"format_id": "137", "vcodec": "avc1.640028", "acodec": "none", "filesize": null}]}
JSON
